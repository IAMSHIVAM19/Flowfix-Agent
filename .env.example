# Database Configuration
POSTGRES_DB=flowfix
POSTGRES_USER=flowfix_user
POSTGRES_PASSWORD=flowfix_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://flowfix_user:flowfix_dev_password@localhost:5432/flowfix

# LLM Provider Configuration (options: "openrouter", "ollama", "gemini", "mock")
LLM_ENABLED=true
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Cloud LLM - Free & Paid Models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local LLM Provider (Ollama)
LLM_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434

# Optional: Google Gemini Provider
GEMINI_API_KEY=

# Testing / Mock Provider
MOCK_LLM_SCENARIO=high_urgency

# Address Autocomplete & Geocoding
# 100% Free & Open Source: Powered automatically by OpenStreetMap (No API key or payment needed!)